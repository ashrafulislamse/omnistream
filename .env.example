# OmniStream Environment Variables

# Appwrite Configuration
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id 
VITE_APPWRITE_DATABASE_ID=omnistream

# Appwrite Function IDs (used by browser extension auto-config)
VITE_CLOUD_SERVICE_FN_ID=cloud-service
VITE_PLATFORM_API_FN_ID=platform-api

# Google OAuth (for Google Drive integration)
# Create credentials at: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Optional: Analytics
VITE_GA_TRACKING_ID=
